---
// src/components/TOC.astro
export interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

// Filter to H2 and H3 only
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocItems.length > 0 && (
  <nav class="docs-toc" aria-label="On this page">
      <ul class="toc-list">
        {tocItems.map((item) => (
          <li class={`toc-item level-${item.depth}`}>
            <a
              href={`#${item.slug}`}
              class="toc-link"
              data-target={item.slug}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
  </nav>
)}

<style>
  /* ── TOC shell ── */
  .docs-toc {
    width: 100%;
    flex-shrink: 0;
    padding-top: 0.5rem;
  }

  /* ── TOC list ── */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item.level-3 {
    padding-left: 1rem;
  }

  /* ── TOC links ── */
  .toc-link {
    display: block;
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
    color: var(--kanariv-text-muted);
    text-decoration: none;
    border-radius: 8px;
    margin: 0.05rem 0;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      transform 0.1s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    position: relative;
  }

  .toc-link:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--kanariv-text);
    transform: translateX(4px);
  }

  .toc-link.active {
    background-color: var(--kanariv-brand-subtle);
    color: var(--kanariv-brand);
    font-weight: 500;
    box-shadow: inset 0 0 0 1px var(--kanariv-brand);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .toc-link {
      transition-duration: 0.01ms !important;
    }
  }

  /* ── Mobile: hide TOC ── */
  @media (max-width: 768px) {
    .docs-toc {
      display: none;
    }
  }
</style>

<script>
  // Scroll spy: highlight current TOC item based on scroll position
  const links = document.querySelectorAll('.toc-link');
  const observerOptions = {
    rootMargin: '-10% 0px -60% 0px',
    threshold: 0,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        links.forEach((link) => {
          link.classList.toggle('active', link.dataset.target === id);
        });
      }
    });
  }, observerOptions);

  // Observe all heading elements
  document.querySelectorAll('h2, h3').forEach((heading) => {
    observer.observe(heading);
  });
</script>
