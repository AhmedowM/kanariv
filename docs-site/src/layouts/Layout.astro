---
// src/layouts/Layout.astro
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import TOC from '../components/TOC.astro';
import '../styles/custom.css';

export interface Props {
  currentSection: string;
  currentPage: string;
  title: string;
  description?: string;
  headings?: any[];
}

const { currentSection, currentPage, title, description, headings } = Astro.props;

function getSection(slug: string): string {
  const parts = slug.split('/');
  return parts[0];
}

const section = getSection(currentPage);
const showTOC = headings && headings.length > 0;
---

<!DOCTYPE html>
<html lang="en" data-theme="light" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7fb" />
    <meta property="og:title" content="{title} — kanariv docs" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://ahmedowm.github.io/kanariv${currentPage.startsWith('/') ? currentPage : '/' + currentPage}`} />
    <meta property="og:image" content="https://ahmedowm.github.io/kanariv/assets/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}assets/logo-mark-180.png`} />
    <style is:inline>
      :root { color-scheme: light; background: #f6f7fb; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) { color-scheme: dark; background: #10131b; }
      }
      html[data-theme="dark"] { color-scheme: dark; background: #10131b; }
      body { background: inherit; }
    </style>
    <title>{title} — kanariv docs</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {
        // Storage can be unavailable in privacy-restricted browsers.
      }

      // TOC toggle state: persisted in localStorage, default open on desktop
      function initToc() {
        const html = document.documentElement;
        const saved = localStorage.getItem('kanariv-toc');
        const isDesktop = window.matchMedia('(min-width: 769px)').matches;
        const open = saved === null ? isDesktop : saved === 'open';
        html.dataset.tocOpen = open;
      }

      window.toggleToc = function () {
        const html = document.documentElement;
        const open = html.dataset.tocOpen === 'true';
        html.dataset.tocOpen = String(!open);
        localStorage.setItem('kanariv-toc', open ? 'closed' : 'open');
      };

      initToc();
    </script>
  </head>
  <body class="docs-body page-enter">
    <Header currentSection={section} />

    <div class="docs-shell">
      <main class={showTOC ? 'docs-content' : 'docs-content no-toc'} id="main-content">
        <div class="docs-content-inner">
          <slot />
        </div>
      </main>

      {showTOC && (
        <aside class="docs-toc-right" aria-label="On this page">
          <TOC headings={headings} />
        </aside>
      )}
    </div>

    <footer class="docs-footer">
      <div class="footer-inner">
        <p>© {new Date().getFullYear()} kanariv. MIT License.</p>
        <a href="https://github.com/AhmedowM/kanariv" target="_blank" rel="noopener">
          GitHub
        </a>
      </div>
    </footer>

    <style>
      /* ── Page entrance animation ── */
      .page-enter {
        animation: pageFadeIn var(--kanariv-duration-base) var(--kanariv-ease-out) both;
      }

      @keyframes pageFadeIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ── Body ── */
      .docs-body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
          Arial, sans-serif;
        background: var(--kanariv-bg);
        color: var(--kanariv-text);
        line-height: 1.6;
        transition:
          background 0.35s ease,
          color 0.35s ease;
      }

      /* ── Shell ── */
      .docs-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        width: 100%;
        margin: 0 auto;
        padding: 0 0 0 1rem;
        min-height: calc(100vh - 4.5rem - 70px);
      }

      /* ── Right TOC (sticky, scrollable panel bounded by the content shell) ── */
      .docs-toc-right {
        position: sticky;
        top: 4.5rem;
        align-self: flex-start;
        width: 100%;
        max-height: calc(100vh - 4.5rem);
        overflow-y: auto;
        padding: 0.75rem 0 2rem 1rem;
        border-left: 1px solid var(--kanariv-border);
        background: color-mix(in srgb, var(--kanariv-surface) 95%, transparent);
        backdrop-filter: blur(8px);
        z-index: 50;
        transition: opacity 0.2s ease;
      }

      /* Hide TOC when closed via data attribute */
      html[data-toc-open="false"] .docs-toc-right {
        display: none;
      }

      /* ── Main content ── */
      .docs-content {
        min-width: 0;
        width: auto;
        padding: 2rem 0 4rem;
      }

      .docs-content-inner {
        width: min(860px, 100%);
        max-width: 860px;
        margin: 0 auto;
      }

      /* Pages without a TOC: center the content */
      .docs-content.no-toc {
        padding-right: 0;
      }
      .docs-content.no-toc .docs-content-inner {
        margin: 0 auto;
        width: min(860px, 100%);
      }

      /* ── Prevent text clipping: wrap long words/URLs/C++ signatures ── */
      .docs-content-inner h1,
      .docs-content-inner h2,
      .docs-content-inner h3,
      .docs-content-inner h4,
      .docs-content-inner p,
      .docs-content-inner code,
      .docs-content-inner pre,
      .docs-content-inner li {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .docs-content-inner h1 {
        overflow-wrap: break-word;
        word-break: break-word;
      }

      /* ── Footer ── */
      .docs-footer {
        margin-top: auto;
        border-top: 1px solid var(--kanariv-border);
        padding: 2rem 1.5rem;
        background: var(--kanariv-surface);
        color: var(--kanariv-text-muted);
        font-size: 0.875rem;
      }

      .footer-inner {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .footer-inner a {
        color: var(--kanariv-brand);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .footer-inner a:hover {
        color: var(--kanariv-brand-emphasize);
        text-decoration: underline;
      }

      [data-theme="light"] .footer-inner a {
        color: var(--kanariv-brand);
      }

      /* ── Reduced motion ── */
      @media (prefers-reduced-motion: reduce) {
        .docs-body,
        .docs-shell,
        .docs-content,
        .page-enter {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* ── Mobile ── */
      @media (max-width: 768px) {
        .docs-shell {
          display: flex;
          flex-direction: column;
          padding: 1rem 1rem 3rem;
        }
        .docs-toc-right {
          order: -1;
          position: sticky;
          top: 4.5rem;
          width: 100%;
          max-height: calc(100vh - 4.5rem);
          overflow-y: auto;
          padding: 1rem;
          border-left: none;
          border-bottom: 1px solid var(--kanariv-border);
          background: var(--kanariv-surface);
          z-index: 55;
        }
        .docs-content {
          width: 100%;
        }
        .docs-content-inner {
          width: 100%;
          max-width: 100%;
          margin: 0;
        }

        /* On mobile, default to TOC closed */
        html[data-toc-open="false"] .docs-toc-right {
          display: none;
        }
      }
    </style>

    <script>
    </script>
  </body>
</html>
