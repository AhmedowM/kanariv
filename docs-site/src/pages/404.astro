---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  currentSection=""
  currentPage="404"
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <div class="not-found">
    <div class="not-found-content">
      <h1>404</h1>
      <p class="not-found-message">
        Page not found. The documentation page you're looking for
        doesn't exist or has been moved.
      </p>
      <div class="not-found-actions">
        <a href={`${BASE}/`} class="not-found-button">Go to Homepage</a>
        <a href={`${BASE}/getting-started/`} class="not-found-link">Getting Started</a>
        <a href={`${BASE}/reference/`} class="not-found-link">Reference</a>
        <a href={`${BASE}/guides/`} class="not-found-link">Guides</a>
      </div>
    </div>
  </div>

  <style>
    .not-found {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: calc(100vh - 13rem);
      padding: 4rem 1rem;
    }

    .not-found-content {
      text-align: center;
      max-width: 560px;
    }

    .not-found h1 {
      font-size: 5rem;
      font-weight: 800;
      letter-spacing: -0.05em;
      margin: 0 0 1rem;
      background: linear-gradient(135deg, var(--kanariv-brand) 0%, var(--kanariv-accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
    }

    .not-found-message {
      font-size: 1.125rem;
      color: var(--kanariv-text-muted);
      margin: 0 0 2rem;
      line-height: 1.6;
    }

    .not-found-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .not-found-button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      background: var(--kanariv-brand);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      transition:
        background var(--kanariv-duration-fast) var(--kanariv-ease-out),
        transform var(--kanariv-duration-fast) var(--kanariv-ease-out);
    }

    .not-found-button:hover {
      background: var(--kanariv-brand-emphasize);
      transform: translateY(-1px);
    }

    .not-found-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.1rem;
      color: var(--kanariv-text);
      background: var(--kanariv-surface);
      border: 1px solid var(--kanariv-border);
      border-radius: 10px;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition:
        color var(--kanariv-duration-fast) var(--kanariv-ease-out),
        border-color var(--kanariv-duration-fast) var(--kanariv-ease-out),
        transform var(--kanariv-duration-fast) var(--kanariv-ease-out);
    }

    .not-found-link:hover {
      color: var(--kanariv-brand-emphasize);
      border-color: var(--kanariv-brand);
      text-decoration: none;
      transform: translateY(-1px);
    }
  </style>
</Layout>
