---
import Layout from '../layouts/Layout.astro';
---

<Layout
  currentSection=""
  currentPage="search"
  title="Search"
  description="Search the caudio documentation."
>
  <div class="search-page">
    <p class="eyebrow">Documentation index</p>
    <h1>Search the docs</h1>
    <p class="search-intro">Find guides, concepts, and API references across caudio.</p>
    <form class="search-page-form" id="search-page-form" role="search">
      <label for="search-page-input">Search documentation</label>
      <div class="search-page-input-wrap">
        <input id="search-page-input" type="search" placeholder="Try “IPC”, “library”, or “quickstart”" autocomplete="off" />
        <button type="submit">Search</button>
      </div>
    </form>
    <div id="search-page-results" class="search-page-results" aria-live="polite"></div>
  </div>
</Layout>

<style>
  .search-page { max-width: 760px; padding: 3rem 0 5rem; }
  .eyebrow { color: var(--caudio-brand); font-size: .78rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .search-intro { color: var(--caudio-text-muted); font-size: 1.1rem; }
  .search-page-form { margin-top: 2rem; }
  .search-page-form label { display: block; margin-bottom: .55rem; color: var(--caudio-text-muted); font-size: .85rem; font-weight: 650; }
  .search-page-input-wrap { display: flex; gap: .65rem; }
  .search-page-input-wrap input { min-width: 0; flex: 1; padding: .85rem 1rem; color: var(--caudio-text); background: var(--caudio-surface); border: 1px solid var(--caudio-border); border-radius: 10px; }
  .search-page-input-wrap button { padding: .85rem 1.25rem; color: #fff; background: var(--caudio-brand); border: 0; border-radius: 10px; font-weight: 700; }
  .search-page-input-wrap button:hover { background: var(--caudio-brand-emphasize); }
  :global(.search-page-results) { display: grid; gap: .7rem; margin-top: 2.5rem; }
  :global(.search-page-result) { display: block; padding: 1rem 1.1rem; background: var(--caudio-surface); border: 1px solid var(--caudio-border); border-radius: 12px; box-shadow: var(--caudio-shadow); }
  :global(.search-page-result:hover) { border-color: var(--caudio-brand); text-decoration: none; transform: translateY(-2px); }
  :global(.search-page-result strong) { display: block; color: var(--caudio-text); }
  :global(.search-page-result span) { display: block; margin-top: .25rem; color: var(--caudio-text-muted); font-size: .9rem; }
  :global(.search-page-status) { color: var(--caudio-text-muted); }
  @media (max-width: 520px) { .search-page-input-wrap { flex-direction: column; } }
</style>

<script>
  const form = document.querySelector('#search-page-form');
  const input = document.querySelector('#search-page-input');
  const results = document.querySelector('#search-page-results');
  const basePath = document.documentElement.dataset.base?.replace(/\/$/, '') || '';
  let indexPromise;
  const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
  input.value = initialQuery;

  async function getIndex() {
    indexPromise ??= fetch(`${basePath}/search-index.json`).then((response) => {
      if (!response.ok) throw new Error('Search index unavailable');
      return response.json();
    });
    return indexPromise;
  }

  async function renderResults(query) {
    if (!query) {
      results.innerHTML = '<p class="search-page-status">Enter a search term to get started.</p>';
      return;
    }
    results.innerHTML = '<p class="search-page-status">Searching…</p>';
    try {
      const index = await getIndex();
      const terms = query.normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu, ' ').trim().split(/\s+/);
      const matches = index
        .map((item) => {
          const title = item.title.toLowerCase();
          const text = item.searchText || `${title} ${item.description || ''} ${item.content || ''}`.toLowerCase();
          const score = terms.reduce((total, term) => total + (title.includes(term) ? 5 : 0) + (text.includes(term) ? 1 : 0), 0);
          return { item, score };
        })
        .filter(({ score }) => score >= terms.length)
        .sort((a, b) => b.score - a.score)
        .map(({ item }) => item)
        .slice(0, 20);
      results.innerHTML = matches.length
        ? matches.map((item) => `<a class="search-page-result" href="${basePath}${item.url}"><strong>${item.title}</strong><span>${item.description || 'Documentation page'}</span></a>`).join('')
        : '<p class="search-page-status">No pages matched that search.</p>';
    } catch {
      results.innerHTML = '<p class="search-page-status">Search is unavailable right now.</p>';
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    renderResults(input.value.trim());
  });
  renderResults(initialQuery);
</script>
